# Copy to C:\docker\audiobook-organizer\.env on the Audiobookshelf server and adjust the paths there.
# Both folders are local disks on the server. The library is the same folder Audiobookshelf reads.

# Folder where new MP3/M4B books land; bind-mounted at /incoming.
INCOMING_DIR=D:\audiobooks_incoming
# Folder for the organized library; bind-mounted at /library.
LIBRARY_DIR=D:\audiobooks
