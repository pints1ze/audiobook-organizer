# Copy to C:\docker\audiobook-organizer\.env and fill in the credentials there.
# The SMB credentials belong only in that untracked .env, never in the repo.

# SMB server name (or its IP address if the name doesn't resolve from Docker).
SMB_SERVER=cookserv
# SMB account with read and write access to both folders below.
SMB_USERNAME=
# Its password. A comma in the password breaks the mount options.
SMB_PASSWORD=
# Share folder where new MP3/M4B books land; mounted at /incoming. Forward slashes, not a drive letter.
INCOMING_SHARE=//cookserv/d/audiobooks_incoming
# Share folder for the organized library; mounted at /library.
LIBRARY_SHARE=//cookserv/d/audiobooks
