# Copy to .env and set each path to a folder on the server. docker-compose.yml mounts them.
# Database (audiobooks.db) lives here; mounted at /data.
DATA_DIR=/srv/audiobooks/data
# Folder where new MP3/M4B books land; mounted at /incoming.
INCOMING_DIR=/srv/audiobooks/incoming
# Organized library the app writes to (may be on another disk); mounted at /library.
LIBRARY_DIR=/srv/audiobooks/library
